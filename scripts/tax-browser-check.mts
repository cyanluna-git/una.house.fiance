 await factForm.getByLabel('세목',{exact:true}).selectOption('penalty');
 await factForm.getByLabel('금액 근거').selectOption('source');
 await factForm.getByLabel('관측 검토 상태').selectOption('observed');
 await factForm.getByLabel('금액 (빈칸 미상, 음수 허용)').fill('5');
 await factForm.getByLabel('근거 페이지').fill('2');
 await factForm.getByRole('button',{name:'금액 이력 추가',exact:true}).click();
 await page.getByText('저장했습니다.',{exact:true}).waitFor();
 checks.push('explicit penalty five won saved by manual fact form');
 await page.getByLabel('대상 별칭',{exact:true}).fill('Synthetic browser');
 await page.getByRole('button',{name:'대상 등록',exact:true}).click();
 await page.getByText('저장했습니다.',{exact:true}).waitFor(); checks.push('manual form saved through protected API');
 const identityForm=page.locator('form').filter({has:page.getByRole('button',{name:'신원 검토 저장',exact:true})});
 await identityForm.getByLabel('대상',{exact:true}).selectOption(String(sid));
 await identityForm.getByLabel('검토 대상 별칭').fill('Synthetic annual fixture');
 await identityForm.getByLabel('명시적 신원 상태').selectOption('confirmed');
 await identityForm.getByRole('button',{name:'신원 검토 저장',exact:true}).click();
 await page.getByText('신원 confirmed',{exact:false}).waitFor(); checks.push('explicit identity form review independent of facts');
