 const linkForm=page.locator('form').filter({has:page.getByRole('button',{name:'연결 이력 추가',exact:true})});
 const tid=historical.transactions.rows[0].id;
 async function fillLink(status:string,confirms?:number) {
  await linkForm.getByLabel('버전',{exact:true}).selectOption(String(historyVersion));
